<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  A launchd job that runs FinScope's check every day at 08:00 local time.
  __FINSCOPE_DIR__ is replaced with the project folder when installing (see the README).
  If the Mac is asleep at 08:00, the run happens when it wakes; if it is off, that day is
  skipped, and the next check still compares against the last filing it saw.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.finscope.check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__FINSCOPE_DIR__/scripts/scheduled-check.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
